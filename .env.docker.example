# Optional Docker Compose settings. This file contains no model credentials.
# The platform starts without it. Users enter their own model API keys in the
# web console, where they are retained as protected runtime data.

# Change this only when port 8080 is occupied.
AGENTFORGE_PORT=8080

# When deployed behind a real domain/reverse proxy, set the public address.
# AGENTFORGE_PUBLIC_BASE_URL=https://agentforge.example.com
