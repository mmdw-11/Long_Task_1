# === OpenAI 模型配置 ===
# 复制本文件为 .env 并填入真实值。切勿把含密钥的 .env 提交到版本库。

# 必填：OpenAI / 兼容服务的 API Key
OPENAI_API_KEY=sk-your-key-here

# 可选：模型名（默认 gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# 可选：兼容端点地址（如自建网关 / 中转 / vLLM）。使用官方 OpenAI 时留空即可。
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Device / Edge execution backends ===
# DEVICE_* is used by LocalModelExecutor. Point it at an OpenAI-compatible
# local service such as vLLM, llama.cpp server, Ollama's OpenAI endpoint, or LM Studio.
# Leave empty to keep the safe LocalEchoExecutor fallback.
# DEVICE_BASE_URL=http://127.0.0.1:11434/v1
# DEVICE_MODEL=qwen2.5:0.5b-instruct
# DEVICE_API_KEY=ollama

# EDGE_ENDPOINT is used by EdgeHttpExecutor. The service should accept:
#   {"prompt": "...", "system_prompt": "...", "metadata": {...}}
# and return:
#   {"text": "...", "model": "...", "metadata": {...}}
# Leave empty or use edge://default to keep the edge fallback.
# EDGE_ENDPOINT=http://127.0.0.1:8001/infer
# EDGE_MODEL=edge-medium-llm
