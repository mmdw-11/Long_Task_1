# === Cloud model: DeepSeek OpenAI-compatible API ===
# Copy this file to .env and fill in your real key. Never commit .env.
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Optional: use deepseek-v4-pro as judge/large model for harder evaluation.
OPENAI_JUDGE_MODEL=deepseek-v4-flash
OPENAI_LARGE_MODEL=deepseek-v4-flash
OPENAI_SMALL_MODEL=deepseek-v4-flash

# === Device model: Ollama on local machine ===
DEVICE_BASE_URL=http://127.0.0.1:11434/v1
DEVICE_ENDPOINT=http://127.0.0.1:11434/v1
DEVICE_MODEL=qwen2.5:0.5b-instruct
DEVICE_API_KEY=ollama
DEVICE_TIMEOUT_SECONDS=120

# === Edge model: Ollama HTTP wrapper ===
# Start it with:
#   python examples/edge_cloud_scheduler/edge_ollama_server.py
EDGE_ENDPOINT=http://127.0.0.1:8001/infer
EDGE_MODEL=qwen2.5:3b-instruct
EDGE_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
EDGE_OLLAMA_API_KEY=ollama

# Web console authentication
AUTH_REQUIRED=1
AUTH_DB_PATH=runs/auth/users.sqlite3
# Local development only. Production must set this to 0 and send reset tokens by email.
AUTH_EXPOSE_RESET_TOKEN=1
EDGE_TIMEOUT_SECONDS=120

# === Learned routing switch ===
USE_PRODUCTION_ROUTER=1
ROUTER_MODEL_BACKEND=bge_m3

# === drift ===
CONTEXT_POLICY_PATH=configs/context_policy.yaml
TASK_DRIFT_API_KEY=sk-your-deepseek-key-here
TASK_DRIFT_MODEL=deepseek-v4-flash
TASK_DRIFT_BASE_URL=https://api.deepseek.com
