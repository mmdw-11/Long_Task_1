# Copy this file to .env. Keep real keys only in .env; never commit that file.
# Restart the backend after changing .env. The model management screen accepts
# each connection's API Key directly; these values remain useful for legacy
# schedulers, evaluation, and command-line features.

# === Cloud / OpenAI-compatible model ===
# DeepSeek example. For Qwen, GLM, OpenAI, etc. replace all three values with the
# provider's compatible endpoint, actual model ID, and your own API key.
OPENAI_API_KEY=sk-your-provider-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash
# Used by routing, evaluation, and optional long-task features. Usually keep them
# identical to OPENAI_MODEL unless you intentionally use separate models.
OPENAI_JUDGE_MODEL=deepseek-v4-flash
OPENAI_LARGE_MODEL=deepseek-v4-flash
OPENAI_SMALL_MODEL=deepseek-v4-flash

# Optional compatibility alias for existing DeepSeek deployments. Do not set both
# unless they intentionally contain the same key.
# DEEPSEEK_API_KEY=

# === Device model: local Ollama ===
# Start Ollama and pull this model first: ollama pull qwen2.5:0.5b-instruct
DEVICE_BASE_URL=http://127.0.0.1:11434/v1
DEVICE_ENDPOINT=http://127.0.0.1:11434/v1
DEVICE_MODEL=qwen2.5:0.5b-instruct
DEVICE_API_KEY=ollama
DEVICE_TIMEOUT_SECONDS=120
DEVICE_MAX_TOKENS=1024

# === Edge model: Ollama / OpenAI-compatible edge service ===
# If using the supplied edge wrapper, start examples/edge_cloud_scheduler/edge_ollama_server.py.
EDGE_ENDPOINT=http://127.0.0.1:8001/infer
EDGE_MODEL=qwen2.5:3b-instruct
EDGE_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
EDGE_OLLAMA_API_KEY=ollama
EDGE_TIMEOUT_SECONDS=120
EDGE_REQUEST_TIMEOUT_SECONDS=120
EDGE_MAX_TOKENS=1024

# === Application server ===
# Set AUTH_REQUIRED=0 only for an isolated local demo. Keep it enabled otherwise.
AUTH_REQUIRED=1
AUTH_DB_PATH=runs/auth/users.sqlite3
AUTH_EXPOSE_RESET_TOKEN=1
# A value of 0 is useful for isolated tests; normal development loads .env automatically.
AGENT_GRAPH_LOAD_DOTENV=1

# === Learned routing / optional task-drift evaluator ===
USE_PRODUCTION_ROUTER=1
ROUTER_MODEL_BACKEND=bge_m3
CONTEXT_POLICY_PATH=configs/context_policy.yaml
# Enable these only when you use the task-drift feature; they may reuse the cloud key.
# TASK_DRIFT_API_KEY=
# TASK_DRIFT_BASE_URL=https://api.deepseek.com/v1
# TASK_DRIFT_MODEL=deepseek-v4-flash
